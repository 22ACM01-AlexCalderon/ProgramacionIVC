Algoritmo sin_titulo
	Definir color, n Como Caracter
	Dimensionar color[8]
	color[1]="morado"
	color[2]="rojo"
	color[3]="verde"
	color[4]="amarillo"
	color[5]="cafe"
	color[6]="lila"
	color[7]="naranja"
	color[8]="negro"
	Escribir Sin Saltar "Dame un numero del 1 al 8: "
	Leer n
	
	Escribir "El color es: ", color[n]
FinAlgoritmo
